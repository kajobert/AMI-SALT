{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ami.example/schemas/support_event.schema.json",
  "title": "AMI-SALT Support Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "event_id",
    "supporter_id",
    "amount_minor",
    "currency",
    "received_at",
    "purpose",
    "public_recognition",
    "evidence_ref"
  ],
  "properties": {
    "version": {"const": "0.1"},
    "event_id": {"type": "string", "minLength": 16, "maxLength": 128},
    "supporter_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "display_name": {"type": ["string", "null"], "maxLength": 100},
    "amount_minor": {"type": "integer", "minimum": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "received_at": {"type": "string", "format": "date-time"},
    "purpose": {
      "type": "string",
      "enum": ["general", "inference", "compute", "storage", "network", "research", "other"]
    },
    "public_recognition": {"type": "boolean"},
    "evidence_ref": {"type": "string", "minLength": 8, "maxLength": 256},
    "note": {"type": ["string", "null"], "maxLength": 500}
  }
}
